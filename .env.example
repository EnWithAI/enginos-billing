# ── Database ────────────────────────────────────────────────────────────────
# The MASTER database, the same one enginos-platform uses. Billing tables live
# beside `tenants` and `org_llm_gateways`; this service owns only its own four.
DATABASE_URL=postgresql://enginos_app:password@localhost:6432/enginos_master?pgbouncer=true&connection_limit=1
# Session mode (port 5432, not PgBouncer) and the DDL role. Prisma Migrate uses
# `directUrl`, not `url` — and `enginos_app` cannot create tables by design, so
# this must be `enginos_owner` or `migrate deploy` fails on schema permissions.
DATABASE_DIRECT_URL=postgresql://enginos_owner:enginos_owner_dev@localhost:5432/enginos_master

# ── Chargebee ───────────────────────────────────────────────────────────────
CHARGEBEE_SITE=enwithai-test
CHARGEBEE_API_KEY=

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_MS=20000

# ── LiteLLM gateway ─────────────────────────────────────────────────────────
# Each prepaid tenant's team max_budget is set here from its credits. Without a
# master key the budget is not pushed (a warning says so). Same key as
# enginos-platform's LITELLM_MASTER_KEY.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
LITELLM_TIMEOUT_MS=10000

# ── Billing rules ───────────────────────────────────────────────────────────
# $1 of LLM spend = this many credits. 1,000 means 1,000 credits = $1.00; 50
# means 50 credits = $1.00. A credit is a BILLING unit, not an LLM token.
# (USD_PER_CREDIT, the same rate stated per credit, is still read when this is unset.)
CREDITS_PER_USD=1000
# Usage is read only up to ClickHouse's now() minus this. Windows are on when
# each LLM call ENDED (span Timestamp + duration_ms), and the span reaches
# ClickHouse after that: MEASURED 2026-09-30 over 421 spans, p50 23 s, p99 44 s,
# 3 over 45 s, 1 over 60 s. A span that lands after its window was read is
# never billed, so shorter bills sooner but loses more.
# MILLISECONDS: 60000 is a minute (the default). A value under 30000 is REFUSED
# at start — 0 included.
# BILLING_ALLOW_SHORT_LAG=true lifts the floor for tests only; never set it in
# a real environment.
BILLING_LAG_MS=60000
# Each pass bills every org from its cursor to now − lag: ordinarily the minute
# since the last pass. This is the longest range ONE Chargebee charge covers,
# which only matters catching up after the worker was down: an hour at a time.
# Chargebee refuses a charge larger than the balance whole, so it is also the
# most an org that ran out mid-outage can have held at once. A pass starts no
# new range after 3 minutes; the next minute's pass carries on from the cursor.
BILLING_MAX_RANGE_MS=3600000
# How often the usage sync passes over every org: once a minute. Under 60000
# the worker makes several passes inside each minute's run (none after 45 s),
# at one Chargebee capture per org per pass with usage.
# With the 1-minute lag and one pass a minute, usage is in Chargebee about two
# minutes after the call ended.
BILLING_SWEEP_INTERVAL_MS=60000
# Unresolved syncs past this many attempts log as errors. The row stays
# unresolved regardless: only Chargebee can resolve an unknown.
BILLING_MAX_ATTEMPTS=10

# ── Callers ─────────────────────────────────────────────────────────────────
# /api/internal/* authenticates no caller: enginos-platform authenticates the
# user and calls it with the tenant id it resolved. Billing trusts that id, so
# /api/internal/* must only be reachable from enginos-platform on the private
# network.
#
# Chargebee's webhook is the one route billing authenticates itself. Chargebee
# does not sign webhooks; it sends the HTTP Basic credentials set on the
# endpoint (Settings > Configure Chargebee > Webhooks), and
# POST /api/webhooks/chargebee checks them against these. Chargebee calls it
# directly at https://<app host>/api/webhooks/chargebee — the load balancer
# (Caddy locally) makes that ONE path of billing public, nothing else.
# Either one empty refuses EVERY delivery (401) — webhooks off, never open.
CHARGEBEE_WEBHOOK_USER=
CHARGEBEE_WEBHOOK_PASSWORD=

# ── Hatchet ─────────────────────────────────────────────────────────────────
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=localhost:7077
# Local engine serves plaintext gRPC; the SDK default breaks the handshake.
HATCHET_CLIENT_TLS_STRATEGY=none

# Plans besides the free plan an org may be on (comma-separated). The free plan
# (FREE_PLAN_ITEM_PRICE_ID) is always included, so leave this empty when it is
# the only one. An org's current subscription is kept whatever this says.
ITEM_PRICE_IDS=
# The plan an org it is for is put on automatically — when enginos-platform
# creates it (POST /api/internal/provision) and, as the fallback, when its
# billing page is opened with no subscription. No checkout and no card, so it
# must cost NOTHING (checked against the catalogue before every create).
# Empty turns automatic subscription off.
FREE_PLAN_ITEM_PRICE_ID=pre-paid-test-v1-INR-Yearly
# Whether an org gets the free plan when an operator has not said otherwise for
# it. false: the org is offered the paid plans (ITEM_PRICE_IDS) instead. Per
# org, an operator sets it with
#   POST /api/internal/free-plan {"tenantId":"<uuid>","enabled":true}
FREE_PLAN_DEFAULT=false
# Credits billing grants an org ONCE, the first time it is linked to the free
# plan. Set the free plan's own Credit Grant to ZERO in the Chargebee catalogue
# first: a plan's grant is issued again at every renewal, this is not. They
# expire 10 years out (allocate requires a date), so in effect never. An org the
# plan already granted is recorded as granted and gets nothing more.
# Empty: off — the plan's own Credit Grant is all an org gets.
FREE_PLAN_CREDITS=
# The Chargebee credit unit those credits go into. REQUIRED with
# FREE_PLAN_CREDITS: a plan that grants zero gets NO credit wallet from
# Chargebee, and billing's allocate into this unit is what creates it. Every
# free org starts with FREE_PLAN_CREDITS in all — a plan that still grants a
# token or two is topped up to it.
FREE_PLAN_CREDIT_UNIT=
# The app's origin: where Chargebee returns the browser after the self-serve
# portal and the card page. Chargebee accepts a redirect only on port 80, 443,
# 8080 or 8443 — http://localhost:4200 is refused, so use the HTTPS dev origin.
APP_URL=https://dev.127.0.0.1.nip.io
# The self-serve portal (POST /api/internal/portal) is OFF unless this is
# exactly `true`. Customers must not be able to cancel, and the portal lets them
# unless "Allow customers to cancel subscriptions" is switched off in the
# Chargebee site's Self-Serve Portal settings. Switch that off first, then set this.
CHARGEBEE_PORTAL_ENABLED=false

# Top-up pack — a ONE-TIME charge that adds credits to the existing
# subscription. Buying another subscription would leave the customer with two.
# An ITEM PRICE id (`api_token-INR`), not the item id (`api_token`): paid
# invoices are matched on it.
#
# The pack is invoiced onto the subscription and collected from the card on
# file at once, after the customer confirms on the billing page (the admin
# UI's Add Charge) — there is no hosted checkout, because Chargebee refuses one
# for a charge that carries a Credit Grant.
#
# The customer picks an AMOUNT; the quantity is amount ÷ the charge's unit
# price. Give the charge PER UNIT pricing in Chargebee — a flat-fee charge can
# only be bought one at a time. The page quotes amounts, never credits: the
# credits are what Chargebee's Credit Grant gives, read from the paid invoice.
TOPUP_ITEM_PRICE_ID=api_token-INR
# true when the charge carries its own Credit Grant INTO THE PLAN'S UNIT:
# Chargebee grants each paid pack and billing only records it (never allocates,
# which would grant twice). false: the charge has no grant and billing
# allocates it itself — and then needs TOPUP_CREDITS (credits per unit); a pack
# it cannot size is held and logged, never granted a guessed amount.
TOPUP_CHARGEBEE_GRANTS=true
# TOPUP_CREDITS=50
# The one-click amounts on the billing page, in the charge's currency (₹ for an
# INR charge), comma-separated. Custom is always offered beside them. An amount
# that is not a whole number of units, or is outside the limits, is not shown.
TOPUP_AMOUNTS=50,100
# Smallest and largest top-up, in the charge's currency. Enforced by billing
# (a request outside them is refused), not only shown by the page. Unset: the
# smallest is one unit, and there is NO largest — set TOPUP_MAX_AMOUNT.
TOPUP_MIN_AMOUNT=
TOPUP_MAX_AMOUNT=

# ── Sentry (worker only) ────────────────────────────────────────────────────
# The worker raises four alerts and nothing else: Postgres down, a Postgres
# write refused, Chargebee down, and usage Chargebee would not take
# (worker/alerts.ts). The API sends nothing. Empty disables Sentry; the worker
# runs the same without it.
SENTRY_DSN=
# Defaults to `production`. Set it per deployment so staging and production
# do not land in one bucket.
# SENTRY_ENVIRONMENT=production
