# ── Database ────────────────────────────────────────────────────────────────
# The MASTER database, the same one enginos-platform uses. Billing tables live
# beside `tenants` and `org_llm_gateways`; this service owns only its own four.
DATABASE_URL=postgresql://enginos_app:password@localhost:6432/enginos_master?pgbouncer=true&connection_limit=1
# Session mode (port 5432, not PgBouncer) and the DDL role. Prisma Migrate uses
# `directUrl`, not `url` — and `enginos_app` cannot create tables by design, so
# this must be `enginos_owner` or `migrate deploy` fails on schema permissions.
DATABASE_DIRECT_URL=postgresql://enginos_owner:enginos_owner_dev@localhost:5432/enginos_master

# ── Chargebee ───────────────────────────────────────────────────────────────
CHARGEBEE_SITE=enwithai-test
CHARGEBEE_API_KEY=

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_MS=20000

# ── LiteLLM gateway ─────────────────────────────────────────────────────────
# Each prepaid tenant's team max_budget is set here from its credits. Without a
# master key the budget is not pushed (a warning says so). Same key as
# enginos-platform's LITELLM_MASTER_KEY.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
LITELLM_TIMEOUT_MS=10000

# ── Billing rules ───────────────────────────────────────────────────────────
# OPEN DECISION: 1 credit = this many USD of LLM spend. The default makes a
# 1,000-credit grant worth $1.00. A credit is a BILLING unit, not an LLM token.
USD_PER_CREDIT=0.001
# Usage is read only up to ClickHouse's now() minus this, so rows still being
# inserted (collector's 5s batch, async-insert flush) are not raced.
# MILLISECONDS: 120000 is two minutes. A value under 10000 is REFUSED at start,
# because the one seen in practice was a seconds-for-milliseconds slip — `120`
# made the worker read up to the present instant, bill windows ClickHouse was
# still filling, and silently never charge the rows that landed a moment late.
# BILLING_ALLOW_SHORT_LAG=true lifts the floor for tests only; never set it in
# a real environment.
BILLING_LAG_MS=120000
# How long one billing window is. FIXED, not "however much is available": a
# window runs from the cursor for exactly this long and is processed only once
# it fits inside now − lag, so its end is a function of its start. That is what
# lets two workers reading the same cursor agree on which window they are
# looking at. It also bounds a catch-up scan after an outage.
BILLING_WINDOW_MS=60000
# Windows one tick may drain for one tenant, so catching up cannot run past the
# workflow's 5-minute timeout.
BILLING_MAX_WINDOWS_PER_TICK=20
# Unresolved syncs past this many attempts log as errors. The row stays
# unresolved regardless: only Chargebee can resolve an unknown.
BILLING_MAX_ATTEMPTS=10

# ── Callers ─────────────────────────────────────────────────────────────────
# Billing authenticates no caller, so there is no API key or webhook password
# to set. enginos-platform authenticates the user, and checks Chargebee's HTTP
# Basic webhook credentials (CHARGEBEE_WEBHOOK_USER / _PASSWORD are in ITS env
# now), then calls /api/internal/* and /api/webhooks/chargebee with the tenant
# id it resolved. Billing trusts that id, so it must only be reachable from
# enginos-platform on the private network.

# ── Hatchet ─────────────────────────────────────────────────────────────────
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=localhost:7077
# Local engine serves plaintext gRPC; the SDK default breaks the handshake.
HATCHET_CLIENT_TLS_STRATEGY=none

# Plans checkout may sell. An allowlist, not a menu — a tampered request cannot
# start a checkout for some other item price in the catalogue.
ITEM_PRICE_IDS=pre-paid-test-v1-INR-Monthly
DEFAULT_ITEM_PRICE_ID=pre-paid-test-v1-INR-Monthly
# Where Chargebee returns the browser after the self-serve portal.
APP_URL=http://localhost:4200
# The self-serve portal (POST /api/internal/portal) is OFF unless this is
# exactly `true`. Customers must not be able to cancel, and the portal lets them
# unless "Allow customers to cancel subscriptions" is switched off in the
# Chargebee site's Self-Serve Portal settings. Switch that off first, then set this.
CHARGEBEE_PORTAL_ENABLED=false

# Top-up pack — a ONE-TIME charge that adds credits to the existing
# subscription. Buying another subscription would leave the customer with two.
# An ITEM PRICE id (`test-top-up-INR`), not the item id (`test-top-up`): the
# checkout reads the price's currency, and paid invoices are matched on it.
# The pack's charge item must NOT carry its own Credit Grant in the Chargebee
# catalogue: hosted one-off checkout refuses such a charge, and billing grants
# the credits itself, into the plan's unit (docs/BILLING-ARCHITECTURE.md §10).
TOPUP_ITEM_PRICE_ID=token-pack-5m-INR
TOPUP_CREDITS=1000
