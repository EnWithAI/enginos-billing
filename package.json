{
  "name": "enginos-billing",
  "version": "0.1.0",
  "private": true,
  "description": "Prepaid token billing: Chargebee credit grants, ClickHouse usage, and a Hatchet sync that cannot double-charge.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 4300",
    "build": "next build",
    "start": "next start --port 4300",
    "worker": "tsx worker/hatchet-worker.ts",
    "worker:dev": "tsx watch worker/hatchet-worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@clickhouse/client": "^1.14.0",
    "@hatchet-dev/typescript-sdk": "1.28.1",
    "@prisma/client": "^6.19.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.8",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
