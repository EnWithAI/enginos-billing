// Billing lives in the MASTER database, beside Tenant and OrgLlmGateway.
//
// Not in a tenant database: the sync sweeps every tenant each tick, and finding
// billable accounts by opening N tenant databases would be both slow and racy.
// Billing is tenant-grain state, so it belongs with tenant-grain state.
//
// This schema is additive. It declares no model for `tenants` or
// `org_llm_gateways` — those are owned by enginos-platform and must not be
// managed from here. `tenant_id` and `routing_slug` are carried as plain
// columns with no Prisma relation, so `prisma migrate` can never propose a
// change to a table this service does not own.
//
// TWO tables carry usage billing, and this is the whole of it:
//
//   billing_account   which Chargebee customer/subscription a tenant is, AND
//                     how far the billing worker has got: the cursor
//   chargebee_sync    one row per billing window: the range it covers, what was
//                     sent, and what Chargebee said about it
//
// A third, `topup_grant`, is not usage billing: it is the idempotency record
// that grants each paid top-up invoice once. Chargebee keeps nothing that ties
// an allocation to the invoice it paid for, so this is the one fact about
// credits the service has to remember itself — see the model below.
//
// Chargebee owns the money. There is no credit ledger here, no balance and no
// billed-event table: the customer's credits, grants, top-ups and consumption
// live in Chargebee and are read from it.
//
// The two responsibilities are deliberately separate, and this is the design:
//
//   billing_account.last_processed_ingested_at   WHERE THE WORKER IS
//   chargebee_sync.status                        WHAT CHARGEBEE SAID
//
// The cursor is the worker's progress checkpoint and nothing else — not a
// Chargebee status, not a payment status, not an event id. It only moves once
// the window in front of it has been resolved, which is what makes a restart
// safe: whatever the cursor says is unfinished gets picked up again.
//
// There is no webhook table. `processed_billing_event` claimed each Chargebee
// event id before acting, and it is gone. Every subscription event is only a
// trigger: the handler re-reads the customer's subscriptions from Chargebee and
// applies what Chargebee says now (services/webhook.service.ts), so a
// redelivery, a late event and a replayed OLD body all converge on the same
// state, and the cursor is create-only so none of them can rewind it.

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/billing"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

/// One row per tenant: the mapping between our tenant and Chargebee, plus the
/// billing worker's position. Every field here is either an identifier a
/// Chargebee call needs, something the billing page renders, or the cursor.
///
/// Deliberately absent: `granted_credits`, `budget_usd`, `cached_balance_*`,
/// `sync_from`. Credit state is Chargebee's; a copy of it here is a second
/// source of truth that can only ever be wrong.
model BillingAccount {
  /// FK to master `tenants.tenant_id` — declared as a plain column, not a
  /// Prisma relation, because this service does not own that table.
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Denormalised from `org_llm_gateways.routing_slug`. Carried here rather
  /// than joined because the gateway row is created fail-open and may be
  /// absent entirely, and because this is the key the ClickHouse query needs:
  /// `tenant_<routing_slug>.span_nodes`.
  routingSlug String @unique @map("routing_slug") @db.VarChar(100)

  /// We supply the Chargebee customer id ourselves (the tenant UUID) rather
  /// than letting Chargebee generate one. That makes customer creation
  /// idempotent: a retry collides on Chargebee's side instead of creating a
  /// second customer for the same tenant.
  chargebeeCustomerId String? @unique @map("chargebee_customer_id") @db.VarChar(100)

  /// The subscription usage is billed against. WHICH subscription that is, when
  /// the customer has several, is a business decision made in
  /// `lib/subscription.ts` — the database only stores the answer.
  chargebeeSubscriptionId String? @unique @map("chargebee_subscription_id") @db.VarChar(100)

  /// The item price the subscription was created from; it carries the Credit
  /// Grant configuration. Rendered on the billing page.
  chargebeeItemPriceId String? @map("chargebee_item_price_id") @db.VarChar(100)

  /// The credit unit from `ledger_account_balances.unit_id`, e.g. "token".
  /// Required on every capture call, so it is cached here rather than fetched
  /// once a minute per tenant.
  ledgerUnitId String? @map("ledger_unit_id") @db.VarChar(50)

  /// Billing contact on the Chargebee customer. Captured at provisioning from
  /// the admin email, because no User row exists yet at that point.
  billingEmail String? @map("billing_email") @db.VarChar(320)

  /// Mirrored from the subscription for display, and for the expiry date a
  /// top-up allocation requires.
  currentTermStart DateTime? @map("current_term_start") @db.Timestamptz()
  currentTermEnd   DateTime? @map("current_term_end") @db.Timestamptz()

  /// unlinked | activating | active | cancelled | exhausted
  ///
  /// Operational state, not financial state: which of them the gateway should
  /// be enforcing and what the page should say. The credit figures behind
  /// `exhausted` come from Chargebee, never from here.
  status String @default("unlinked") @db.VarChar(20)

  /// THE BILLING CURSOR — `span_nodes.ingested_at` up to which this tenant is
  /// fully billed. The next window starts here.
  ///
  /// It is the worker's progress checkpoint and NOTHING else: not a Chargebee
  /// status, not a payment status, not an event id. It moves only when the
  /// window in front of it has been resolved, so a worker that crashes
  /// mid-window finds the cursor still behind that window on restart and
  /// resolves it rather than skipping it.
  ///
  /// Null until the tenant subscribes. Set to now() at activation rather than
  /// left at epoch, because ClickHouse holds 90 days of spans and a cursor at
  /// zero would invoice a quarter of free-plan usage on the first tick.
  ///
  /// Millisecond precision to match `ingested_at`, which is DateTime64(3).
  lastProcessedIngestedAt DateTime? @map("last_processed_ingested_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  syncs  ChargebeeSync[]
  topUps TopUpGrant[]

  @@index([status])
  @@map("billing_account")
}

/// One row per billing window: the ClickHouse range it covers, the usage found
/// in it, and what Chargebee said when it was sent.
///
/// The id is ALSO the Chargebee ledger operation id. One value in two systems
/// is what makes a retry settle instead of re-charge: the id is written here
/// BEFORE the capture is sent, so after a timeout, a crash or a lost response
/// the next tick can ask Chargebee `GET /ledger_operations/{id}` instead of
/// guessing.
///
/// A row exists only where there was usage. An empty window moves the cursor
/// and writes nothing — a log of empty rows is noise, not history.
model ChargebeeSync {
  /// Client-supplied, and sent to Chargebee as the ledger operation id.
  id String @id @default(uuid()) @db.Uuid

  tenantId String         @map("tenant_id") @db.Uuid
  account  BillingAccount @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  /// Pinned when the row is created, so a mid-term subscription change still
  /// settles against the subscription that incurred the usage.
  chargebeeSubscriptionId String? @map("chargebee_subscription_id") @db.VarChar(100)
  ledgerUnitId            String? @map("ledger_unit_id") @db.VarChar(50)

  /// The window, exclusive of `from`, inclusive of `to`. `from` is the cursor
  /// the window opened at, which is what makes the log a chain with no gaps:
  /// the cursor cannot pass a point without a row covering it.
  ///
  /// Both are TIMES. There is no event id in the window boundary — see the
  /// cursor's comment above, and `usage-events.ts` for why a half-open range on
  /// a time boundary cannot split a millisecond the way a row cursor could.
  fromIngestedAt DateTime @map("from_ingested_at") @db.Timestamptz(3)
  toIngestedAt   DateTime @map("to_ingested_at") @db.Timestamptz(3)

  /// PENDING | PROCESSING | SUCCESS | UNKNOWN | RATE_LIMITING | OUT_OF_CREDITS | INVALID | WRITTEN_OFF
  ///
  /// RESOLVED — the cursor may move past it:
  ///   SUCCESS        Chargebee took it, confirmed it already had, or there was
  ///                  nothing chargeable in the window.
  ///   WRITTEN_OFF    refused (OUT_OF_CREDITS or INVALID) on a subscription
  ///                  that has since ended. Nothing was charged and nothing can
  ///                  be; logged once as `billing.sync.written_off`.
  /// UNRESOLVED — the tenant is held here and the row is recovered each tick:
  ///   PENDING        written, not yet sent. Safe to send: the id has never
  ///                  been on the wire.
  ///   PROCESSING     on the wire, outcome not yet recorded. A crash leaves
  ///                  this, and it is resolved by lookup, never by re-sending.
  ///   UNKNOWN        timeout, 5xx, bad credential, disabled site. Same
  ///                  treatment as PROCESSING: ask, do not guess.
  ///   RATE_LIMITING  Chargebee throttled us. Refused before it was applied, so
  ///                  it is simply sent again on a backoff.
  ///   OUT_OF_CREDITS the customer has no balance. Retried every tick, because
  ///                  a top-up clears it with no requeue step.
  ///   INVALID        rejected for bad data or configuration. Retried on a long
  ///                  backoff so a fix heals it, but it needs a person.
  status String @db.VarChar(16)

  /// What was sent to Chargebee, in credits. Ten decimal places is exactly
  /// Chargebee's ledger precision, so a value that survives this column
  /// survives the wire without rounding.
  amount Decimal @default(0) @db.Decimal(20, 10)

  /// The dollar figure behind `amount`, for the billing page. Kept because the
  /// page renders it and credits alone do not mean anything to a customer.
  billedUsd Decimal @default(0) @map("billed_usd") @db.Decimal(20, 10)

  eventCount Int @default(0) @map("event_count")

  error String?

  /// Sends attempted for THIS row. It is never turned into a failure by
  /// counting: only Chargebee can resolve an unknown. It sets the backoff for
  /// RATE_LIMITING and INVALID, and past `maxAttempts` the logging gets louder.
  attemptCount Int @default(0) @map("attempt_count")

  /// Correlates a sync back to the workflow run that created it.
  hatchetRunId String? @map("hatchet_run_id") @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One row per window, ever. Two workers that read the same cursor and both
  /// open a window for it collide here — §6, "do not create duplicate sync
  /// records for the same unresolved billing window", as a constraint rather
  /// than as a rule a caller has to remember.
  @@unique([tenantId, fromIngestedAt], map: "chargebee_sync_window_uq")
  /// The billing page's "last synced".
  @@index([tenantId, toIngestedAt(sort: Desc)], map: "chargebee_sync_progress_idx")
  @@index([status], map: "chargebee_sync_status_idx")
  @@map("chargebee_sync")
}

/// One row per paid top-up invoice this service has acted on — the guard that
/// grants a paid pack EXACTLY ONCE.
///
/// Why it is local. `/ledger_operations/allocate` takes no client-supplied id,
/// and Chargebee keeps nothing that ties an allocation to the invoice it was
/// for: MEASURED on the test site, the `metadata` sent on allocate is never
/// returned (not on the ledger operation, list or retrieve; the grant block it
/// creates carries only `{"done_by": <api key name>}`). The old guard scanned
/// for that metadata, matched nothing, and every repeat of `apply` past the
/// 30-minute idempotency-key window granted the pack again (known defect #1).
///
/// How it is written. The row is CLAIMED (status SENDING) and committed before
/// the allocate leaves, carrying every parameter the allocate is sent with; it
/// becomes APPLIED with the operation id once Chargebee answers. A crash in
/// between leaves the claim, so the record is never lost, and the retry
/// re-sends the SAME request under the SAME `chargebee-idempotency-key` —
/// which Chargebee answers with the original result rather than granting
/// again. See account.service.ts applyPaidTopUps for the whole state machine.
///
/// A pack whose item price carries its OWN Credit Grant is granted by
/// Chargebee, not by us; it is recorded here as `catalogue_grant` with the
/// grant block that proves it, and nothing is allocated.
///
/// NEVER DROP, TRUNCATE OR EMPTY THIS TABLE once it is in use, and never delete
/// a row: every paid pack invoice stays listed by Chargebee for good, and one
/// with no row here is granted again. That is also why the account relation is
/// RESTRICT, not CASCADE — deleting a billing_account row (a common dev repair)
/// must not take the guard with it.
model TopUpGrant {
  id String @id @default(uuid()) @db.Uuid

  tenantId String         @map("tenant_id") @db.Uuid
  account  BillingAccount @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  /// The paid Chargebee invoice. One row per (tenant, invoice), ever.
  invoiceId String @map("invoice_id") @db.VarChar(100)

  /// Where the credits went — pinned when the row is claimed, so a retry
  /// after a resubscription still completes against the same subscription.
  chargebeeSubscriptionId String  @map("chargebee_subscription_id") @db.VarChar(100)
  ledgerUnitId            String  @map("ledger_unit_id") @db.VarChar(50)
  credits                 Decimal @db.Decimal(20, 10)

  /// The allocate request, stored before it is first sent, so every retry is
  /// byte-for-byte the same request — which is what the idempotency key
  /// requires. Null for a catalogue grant, which sends nothing. Replaced, with
  /// the key, only when a NEW key is issued (the old one's window has passed,
  /// so the body may change): then it is recomputed from the current term.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(120)
  /// When this key was first sent. Chargebee replays a key for 30 minutes.
  keyIssuedAt    DateTime? @map("key_issued_at") @db.Timestamptz(3)

  /// SENDING | PENDING | APPLIED
  ///   SENDING   claimed; an allocate is on the wire under this claim
  ///   PENDING   an allocate may have landed, outcome unknown; retried
  ///   APPLIED   granted — by our allocate, or by Chargebee's own grant
  status String @db.VarChar(16)

  /// allocation | catalogue_grant
  source String @db.VarChar(20)

  /// What proves it was granted: `ledger_operation:<id>` or `grant_block:<id>`.
  chargebeeRef String? @map("chargebee_ref") @db.VarChar(120)
  /// When Chargebee made the grant: the allocation's `created_at`, which is its
  /// grant block's. How the guard tells THIS row's block from another's when it
  /// searches the blocks for an allocation whose answer was lost. Null when
  /// Chargebee did not say; read back by operation id when it is needed.
  operationAt  DateTime? @map("operation_at") @db.Timestamptz(3)

  attemptCount Int     @default(0) @map("attempt_count")
  error        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(3)

  /// The guard itself: two callers applying the same invoice collide here.
  @@unique([tenantId, invoiceId], map: "topup_grant_invoice_uq")
  @@map("topup_grant")
}
